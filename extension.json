{
  "name": "The",
  "version": "1.0.1",
  "author": [
    "JoeyTatu"
  ],
  "url": "https://www.mediawiki.org/wiki/Extension:The",
  "descriptionmsg": "the-desc",
  "license-name": "MIT",
  "type": "other",
  "requires": {
    "MediaWiki": ">= 1.46.0"
  },
  "manifest_version": 2,
  "AutoloadNamespaces": {
    "MediaWiki\\Extension\\The\\": "includes/"
  },
  "Hooks": {
    "BeforePageDisplay": "TheHooks"
  },
  "config": {
    "TheReplacements": {
      "value": {
        "the": "hte"
      }
    },
    "TheHighlight": {
      "value": true
    }
  },
  "ResourceModules": {
    "ext.the": {
      "scripts": [
        "resources/ext.the.js"
      ],
      "styles": [
        "resources/ext.the.css"
      ],
      "dependencies": [
        "mediawiki.util"
      ],
      "localBasePath": "",
      "remoteExtPath": "The"
    }
  },
  "MessagesDirs": {
    "The": [
      "i18n"
    ]
  },
  "HookHandlers": {
    "TheHooks": {
      "class": "MediaWiki\\Extension\\The\\Hooks"
    }
  }
}
